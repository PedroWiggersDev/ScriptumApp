<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scriptum_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <include layout="@layout/view_scriptum_brand" />

        <ImageButton
            android:id="@+id/detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar aos documentos"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/scriptum_green" />

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/scriptum_green"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/scriptum_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/scriptum_card_background"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:textColor="@color/scriptum_ink"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
