<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/scriptum_input_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/document_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/scriptum_ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/document_item_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/scriptum_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/document_item_status"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:textColor="@color/scriptum_green"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
