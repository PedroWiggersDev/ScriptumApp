<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scriptum_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="42dp"
            android:background="@drawable/scriptum_logo_background"
            android:contentDescription="@null"
            android:padding="16dp"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Scriptum"
            android:textColor="@color/scriptum_green"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Suas anotações, a toda hora.\nNa palma da sua mão."
            android:textColor="@color/scriptum_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/scriptum_card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usuário"
                android:textColor="@color/scriptum_ink"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/login_username"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/scriptum_input_background"
                android:hint="Digite o usuário"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/scriptum_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/login_username_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/scriptum_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Senha"
                android:textColor="@color/scriptum_ink"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/login_password"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/scriptum_input_background"
                android:hint="Digite sua senha"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/scriptum_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/login_password_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/scriptum_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/login_form_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/scriptum_error"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/login_submit"
                style="@style/ScriptumPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:text="Entrar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
