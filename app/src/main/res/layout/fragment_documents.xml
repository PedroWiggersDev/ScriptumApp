<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scriptum_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <include layout="@layout/view_scriptum_brand" />

        <ImageButton
            android:id="@+id/documents_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar para categorias"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/scriptum_green" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Documentos"
            android:textColor="@color/scriptum_green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/scriptum_card_background"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/documents_category_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/scriptum_green"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/documents_category_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/scriptum_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/documents_search"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/scriptum_input_background"
            android:hint="⌕  Buscar documentos"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="@color/scriptum_ink" />

        <Button
            android:id="@+id/document_create"
            style="@style/ScriptumPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Criar novo documento" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/scriptum_card_background"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Documentos da categoria"
                android:textColor="@color/scriptum_green"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/documents_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Carregando documentos..."
                android:textColor="@color/scriptum_muted"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/documents_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
